{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Syncing Gei memory",
            "timeout": 60,
            "additionalContextLimit": 3000,
            "command": "node \"${PLUGIN_ROOT}/hooks/session_start.mjs\" --codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "node \"${PLUGIN_ROOT}/hooks/user_prompt.mjs\" --codex"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "additionalContextLimit": 3000,
            "command": "node \"${PLUGIN_ROOT}/hooks/subagent_start.mjs\" --codex"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "node \"${PLUGIN_ROOT}/hooks/guard.mjs\" --codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"${PLUGIN_ROOT}/hooks/stop.mjs\" --codex"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"${PLUGIN_ROOT}/hooks/stop.mjs\" --codex"
          }
        ]
      }
    ]
  }
}
