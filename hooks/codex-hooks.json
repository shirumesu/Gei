{
  "description": "Inject the Gei router, project overview, and memory index at session start so routing and cold-start context are present from the first turn.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/inject_overview.mjs\"",
            "statusMessage": "Loading Gei project overview",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/inject_memory.mjs\"",
            "statusMessage": "Loading Gei memory index",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
