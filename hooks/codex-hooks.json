{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Syncing Gei memory",
            "timeout": 60,
            "additionalContextLimit": 3000,
            "command": "node \"${PLUGIN_ROOT}/hooks/session_start.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"${PLUGIN_ROOT}/hooks/stop.mjs\""
          }
        ]
      }
    ]
  }
}
