{
  "description": "Inject Gei project overview and memory index at session start, then enforce a Learn memory check before every Stop in spec-backed projects.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/inject_overview.mjs\"",
            "statusMessage": "Loading Gei project overview",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/inject_memory.mjs\"",
            "statusMessage": "Loading Gei memory index",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/stop_record_memory.mjs\"",
            "statusMessage": "Checking Gei learn memory gate",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
