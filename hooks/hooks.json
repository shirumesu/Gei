{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Loading Gei AGENTS.md",
            "timeout": 10,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_agents.mjs\""
          },
          {
            "type": "command",
            "statusMessage": "Loading Gei shared memory",
            "timeout": 10,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_shared.mjs\""
          },
          {
            "type": "command",
            "statusMessage": "Loading Gei project memory",
            "timeout": 10,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_project.mjs\""
          }
        ]
      }
    ]
  }
}
