{
  "description": "Inject the Gei router and project overview at session start so routing and cold-start context are present from the first turn.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_using_gei.mjs\"",
            "statusMessage": "Loading Gei routing context",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_overview.mjs\"",
            "statusMessage": "Loading Gei project overview",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
