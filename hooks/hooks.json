{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Loading Gei router",
            "timeout": 5,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_using_gei.mjs\""
          },
          {
            "type": "command",
            "statusMessage": "Loading Gei project knowledge",
            "timeout": 5,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_context.mjs\""
          }
        ]
      }
    ]
  }
}
