{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Syncing Gei memory",
            "timeout": 60,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/user_prompt.mjs\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent_start.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.mjs\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.mjs\""
          }
        ]
      }
    ]
  }
}
